# ============================================
# Copy to .env and fill in before `docker compose up`
#   cp .env.example .env
#
# Keep comments on their own lines. Compose treats "KEY=   # text" with an
# empty value as the value "# text", which silently defeats the required-
# variable guard in docker-compose.yml.
#
# Use hex secrets. A base64 password can contain "/" which breaks the
# mongodb:// connection string, and "$" is interpolated by Compose.
# ============================================

# ---- MongoDB (bundled container) ----
MONGO_USER=spt
# REQUIRED. Generate with: openssl rand -hex 24
MONGO_PASSWORD=
MONGO_DB=smart_progress_tracker

# ---- Point at MongoDB Atlas instead of the bundled container ----
# Set this and the mongo service is ignored by the API (it still starts;
# comment the service out of docker-compose.yml if you don't want it).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smart_progress_tracker

# ---- API ----
# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# ---- Web ----
WEB_PORT=8080
CLIENT_URL=http://localhost:8080
